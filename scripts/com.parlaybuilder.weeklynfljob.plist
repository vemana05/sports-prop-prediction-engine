<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.parlaybuilder.weeklynfljob</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vemana/Projects/BettingApp/scripts/weekly_nfl_job.sh</string>
    </array>

    <!-- Saturdays 9:00 AM Eastern (this Mac's timezone): after Friday's
         final NFL injury reports, before Sunday's games. Weekday 6 is
         Saturday (0 and 7 are Sunday). Runs at a different hour from the
         10:00 AM daily odds job so the two never overlap. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vemana/Projects/BettingApp/logs/launchd_weekly_nfl_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vemana/Projects/BettingApp/logs/launchd_weekly_nfl_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
