<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.parlaybuilder.dailyoddsjob</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vemana/Projects/BettingApp/scripts/daily_odds_job.sh</string>
    </array>

    <!-- 10:00 AM — this Mac's system timezone is already America/New_York
         (confirmed via `date`), so this IS 10:00 AM Eastern, 2 hours ahead
         of the earliest NBA games ever tip (noon ET on occasion) and well
         past when books typically have that day's player props posted.
         If this Mac's timezone ever changes, recompute: Hour should equal
         10:00 AM ET converted to whatever zone the Mac is then set to. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vemana/Projects/BettingApp/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vemana/Projects/BettingApp/logs/launchd_stderr.log</string>

    <!-- Don't fire immediately on `launchctl load` — only at the scheduled
         time. Load it once, any day, and the first real run is the next
         10:00 AM. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
